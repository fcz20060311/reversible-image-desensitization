<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.earlyvernal.desensitizationserver.Mapper.UserMapper">


    <select id="selectByUsername" resultType="com.earlyvernal.desensitizationserver.Entity.User">
        SELECT id,username,password,nickname,user.create_time
        FROM user
        WHERE username=#{username}
    </select>
</mapper>